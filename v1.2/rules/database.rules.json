{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['at', 'v', 'game'])",
          "at": { ".validate": "newData.isNumber()" },
          "v": { ".validate": "newData.isNumber()" },
          "game": { ".validate": "newData.isString() && newData.val() === 'beam'" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "$other": { ".validate": false }
        },
        "sig": {
          "$cid": {
            ".validate": "$cid.matches(/^[a-z0-9]{6,16}$/)",
            "offer": {
              ".validate": "newData.hasChildren(['type', 'sdp'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "sdp": { ".validate": "newData.isString() && newData.val().length <= 16000" },
              "$other": { ".validate": false }
            },
            "answer": {
              ".validate": "newData.hasChildren(['type', 'sdp'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "sdp": { ".validate": "newData.isString() && newData.val().length <= 16000" },
              "$other": { ".validate": false }
            },
            "ice": {
              "$side": {
                ".validate": "$side === 'c' || $side === 'd'",
                "$k": {
                  ".validate": "newData.hasChild('candidate')",
                  "candidate": { ".validate": "newData.isString() && newData.val().length <= 600" },
                  "sdpMid": { ".validate": "newData.isString() && newData.val().length <= 32" },
                  "sdpMLineIndex": { ".validate": "newData.isNumber()" },
                  "usernameFragment": { ".validate": "newData.isString() && newData.val().length <= 64" },
                  "$other": { ".validate": false }
                }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "relay": {
          "$cid": {
            ".validate": "$cid.matches(/^[a-z0-9]{6,16}$/)",
            "on": { ".validate": "newData.isBoolean()" },
            "ec": { "$k": { "s": { ".validate": "newData.isString() && newData.val().length <= 16000" }, "$other": { ".validate": false } } },
            "ed": { "$k": { "s": { ".validate": "newData.isString() && newData.val().length <= 16000" }, "$other": { ".validate": false } } },
            "in": { "s": { ".validate": "newData.isString() && newData.val().length <= 400" }, "$other": { ".validate": false } },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
